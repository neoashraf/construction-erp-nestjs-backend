# ── Zakir Enterprise ERP backend — environment template ──────────────────────
# Copy to `.env` and fill real values. `.env` is gitignored; NEVER commit secrets.
# Boot fails fast (config/env.schema.ts) if a required var is missing/invalid.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ze_erp
DB_SSL=false
# Connection pool ceiling (ADR-0002 §2.3 — pool max 20)
DB_POOL_MAX=20

# JWT (consumed by the auth-jwt brief; present here so the schema is stable).
# A scaffold-safe placeholder; replace with a real secret in any deployed env.
JWT_SECRET=change-me-in-real-environments-please-32chars-min
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ── Biometric fingerprint device (HR attendance) ─────────────────────────────
# Two ingestion paths, and they are NOT interchangeable:
#
#   PULL — the server dials the device (UDP :4370) on `POST /api/sync` and on the timer
#          below. Needs LAN reachability, so DEVICE_IP must be set AND routable from this
#          host. This is the reliable path when the server sits on the site LAN.
#   PUSH — the device dials US at `POST /iclock/cdata`. Needs no DEVICE_IP; the tenant comes
#          from the device's serial via `attendance_device`. Only as reliable as the device's
#          own firmware settings — some units stop pushing once a pull marks records read.
#
# Leave DEVICE_IP EMPTY on a host that cannot reach the device LAN (e.g. a cloud VPS behind
# NAT). Pull is then impossible, the auto-sync stays dormant, and push is the only path.
DEVICE_IP=192.168.0.200
DEVICE_PORT=4370
DEVICE_IN_PORT=5200
DEVICE_TIMEOUT_MS=10000

# Minutes between unattended pulls. 0 disables. Requires DEVICE_IP.
# This is what removes the manual "Sync device" click — without it, punches only reach the
# ERP when somebody presses the button or the device happens to push.
DEVICE_SYNC_INTERVAL_MINUTES=3

# Company that punches from an UNREGISTERED device serial are attributed to (PUSH only).
#
# Prefer registering each device in Company settings → Attendance devices instead: in a
# multi-company deployment this funnels EVERY unknown serial into one company. Left empty,
# an unknown serial has its punches DROPPED — and the device is still answered `OK`, so it
# marks them delivered and never resends. The punches are gone, not queued.
DEVICE_DEFAULT_COMPANY_ID=

# Cloudinary — profile-avatar image store (AUD profile slice, FR-AUD-038..043).
# OPTIONAL at boot: leave blank and the app still runs, but avatar upload/delete
# returns MEDIA_STORAGE_ERROR (503). Fill all three (from the Cloudinary dashboard →
# Account Details) to enable profile-photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
